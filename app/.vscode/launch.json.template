{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local container",
      "request": "launch",
      "type": "al",
      "environmentType": "OnPrem",
      "server": "http://YOUR-CONTAINER-HOST",
      "serverInstance": "BC",
      "_comment_auth": "UserPassword or Windows - must match how the container was created. Check with: curl -i http://HOST:7048/BC/api/v2.0/companies and read WWW-Authenticate (Basic = UserPassword, Negotiate/NTLM = Windows).",
      "authentication": "UserPassword",
      "tenant": "default",
      "port": 7049,
      "schemaUpdateMode": "Synchronize",
      "breakOnError": "All",
      "breakOnRecordWrite": "None",
      "launchBrowser": true
    },
    {
      "name": "Cloud sandbox",
      "request": "launch",
      "type": "al",
      "environmentType": "Sandbox",
      "environmentName": "YOUR-SANDBOX-NAME",
      "startupObjectId": 22,
      "startupObjectType": "Page",
      "schemaUpdateMode": "Synchronize",
      "breakOnError": "All",
      "launchBrowser": true
    }
  ]
}
